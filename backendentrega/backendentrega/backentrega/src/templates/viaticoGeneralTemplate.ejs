                                <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Apertura Prog.</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">FF_OF</th>                          
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">C.I.</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 200px;font-size: 8px">Nombre Completo</th>
