<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.15/dist/tailwind.min.css" rel="stylesheet">
    <title>Document</title>
    <style>
        @media print {            
            .column {
                box-sizing: border-box;
                position: relative;
            }
            .logo2 {
                width: 150px;
            }

            .logo {
                width: 55px;
                height: auto;
                margin: auto;
            }

            .qr-code {                
                z-index: 9999;
                padding-right: 1rem;
            }
            .text-center2 {
                text-align: center;
                position: relative;
            }
            .filaPendiente{
                background-color:#ffcccc;
            }
        }
    </style>
</head>

<body class="font-sans">    
    <!-- Header -->
    <header class="bg-gray-500 p-2 text-white">
        <div class="w-full mx-auto flex justify-between items-center">
            <!-- Columna Izquierda -->
            <div class="flex w-1/5">
                <div class="mr-4 text-center">
                    <img src="<%= assetsURL %>/logo2.png" alt="background" class="w-14 h-14 mx-auto" />
                    <p class="font-sans text-xs m-0 mt-2">Seccion Finanzas</p>
                </div>                
            </div>
    
            <!-- Columna Centro -->
            <div class="w-3/5 text-center">
                <div class="flex flex-col justify-between font-sans">
                    <h4 class="text-sm m-0 mb-auto">Gobierno Autónomo del Departamento de Oruro</h4>
                    <h6 class="text-xs m-0 mb-4">Secretaria Deptal. de Administración y Finanzas Publicas</h6>                   
                </div>
                <div class="w-5/5 mr-4 text-center  whitespace-nowrap overflow-hidden text-ellipsis">
                    <h5 class="text-sm font-semibold mt-auto">REPORTE DE PAGO VIATICOS AL PERSONAL DE LA GOBERNACION DE ORURO</h5>
                    <h4 class="text-xs m-0 mb-auto">Correspondiente a las fechas de <%= data.fecha_inicio_filtro %> al  <%= data.fecha_fin_filtro %> </h4>
                      <h4 class="text-sm m-0 mb-auto">(Expresado en Bolivianos)</h4>  
                      <h5 class="text-sm font-semibold mt-auto"><%=data.tipo_reporte  %> </h5>  
                              
                </div>   
            </div>
    
            <!-- Columna Derecha -->
            <div class="w-1/5 text-right">
                <img src="<%= qrCodeDataUrl %>" alt="QR Code" class="w-24 h-24 m-0 p-0 float-right">
            </div>
        </div>
                 
    </header>

    <!-- Main Content -->
    <main class="w-full mx-auto mt-8">
        <!-- Table -->
       
        <!--Cuerpo nuevo de la tabla-->
        <% let total_liquido_pagable = 0;
           let totalPasajesGeneral = 0;
           let totalViaticosGeneral = 0;
