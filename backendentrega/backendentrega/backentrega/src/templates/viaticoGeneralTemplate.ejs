                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.sigla %></td>   
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 120px;font-size: 8px"><%= row.cod_depart_memo %></td>      
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 150px;font-size: 8px"><%= row.destino %></td>  
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.fecha_inicio_viaje %></td> 
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.fecha_fin_viaje %></td>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.total_pasajes %></td> 
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.total_viatico %></td>  
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.liquido_pagable %></td>  
                                    </tr>                               
                                <% }); %>                                            
                                 <!--   <tfoot>
                                    <tr class="bg-gray-300 font-bold" style="background-color: #ADADAD; color: black; font-weight: bold;">
                                        <td colspan="12" class="text-right border border-gray-300" style="font-size: 12px">TOTAL:</td>
                                        <td class="text-center border border-gray-300" style="font-size: 12px"><%= total_liquido_pagable.toFixed(2) %></td>
                                    </tr>
                                    </tfoot>-->
                         <% } %>
                        </tbody>                       
                    <% } %>
                    <% if(data.tipo_reporte === "REPORTE_POR_PLANILLA") {%>
                      <thead>    
                        <tr class="bg-gray-200">
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Num. Recibo</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">FF_OF</th>  
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Apertura Prog.</th>            
