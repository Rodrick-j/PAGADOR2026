                                <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Fecha fin</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Total Pasajes</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Total Viatico</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Liquido Pagable</th>
                            </tr>
                        </thead>
                      <tbody>
                        <% if (data) { %>
                                <% data.rows.forEach(function(row){
                                     totalPasajesGeneral += Number(row.total_pasajes || 0);
                                     totalViaticosGeneral += Number(row.total_viatico || 0);
                                     total_liquido_pagable += parseFloat(row.liquido_pagable || 0); 
