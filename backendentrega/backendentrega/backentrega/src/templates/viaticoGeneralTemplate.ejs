                                            <h5 class="text-sm font-semibold text-center whitespace-nowrap overflow-hidden text-ellipsis"><%=area.nombre%></h5>
                                        </th>
                                    </tr>
                                    <tr class="bg-gray-200">       
                                        <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Num. Recibo</th>                                  
                                        <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">FF_OF</th>  
                                        <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Apertura Prog.</th>                                           
