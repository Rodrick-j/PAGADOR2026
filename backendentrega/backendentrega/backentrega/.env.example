# Copiar este archivo a ".env.local" y completar los valores reales.
# ".env.local" NO se sube a GitHub (esta en el .gitignore). Los valores
# reales se comparten por un canal privado, nunca por el repositorio.

# Secreto para firmar los tokens JWT. Usar una cadena larga y aleatoria.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Host de la base de datos MySQL (ej. localhost o la IP del servidor).
IP_DATABASE=localhost

# Precios unitarios de combustible (Bs por litro).
GASOLINA=3.74
DIESEL=3.72

# URL de la API de feriados (pedir el valor real al equipo).
FERIADOS_BASE=https://ejemplo.invalid/feriados
