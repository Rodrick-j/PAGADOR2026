# Copiar este archivo a ".env.local" (no se sube a GitHub).
# Sirve para correr el frontend en tu maquina contra un backend local.

# URL del backend (ajustar al puerto donde corra tu backend local).
REACT_APP_API_URL=http://localhost:8080

# El dev-server solo escucha en loopback.
HOST=127.0.0.1
PORT=3000

# No abrir el navegador automaticamente.
BROWSER=none
