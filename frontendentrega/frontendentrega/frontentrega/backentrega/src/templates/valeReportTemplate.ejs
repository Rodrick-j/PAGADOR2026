<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.15/dist/tailwind.min.css" rel="stylesheet">
    <title>Document</title>
    <style>
        @media print {            
            .column {
                box-sizing: border-box;
                position: relative;
            }
            .logo2 {
                width: 150px;
            }

            .logo {
                width: 55px;
                height: auto;
                margin: auto;
            }

            .qr-code {                
                z-index: 9999;
                padding-right: 1rem;
            }
            .text-center2 {
                text-align: center;
                position: relative;
            }
            .text-smallest {
                font-size: 0.625rem; 
                line-height: 0.75rem; 
            }
             .table {
                width: 100% !important;
                table-layout: fixed;
            }
            .th, .td {
                word-wrap: break-word;
                font-size: 8px;
            }
            
        }
    </style>
</head>

<body class="font-sans">    
    <!-- Header -->
