<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.15/dist/tailwind.min.css" rel="stylesheet">
    <title>Document</title>
    <style>
        @media print {            
            .column {
                box-sizing: border-box;
                position: relative;
            }
            .logo2 {
                width: 150px;
            }

            .logo {
                width: 55px;
                height: auto;
                margin: auto;
            }

            .qr-code {                
                z-index: 9999;
                padding-right: 1rem;
            }
            .text-center2 {
                text-align: center;
                position: relative;
            }
        }
    </style>
</head>

<body class="font-sans">    
    <!-- Header -->
    <header class="bg-gray-500 p-2 text-white">
        <div class="w-full mx-auto flex justify-between items-center">
            <!-- Columna Izquierda -->
            <div class="flex w-1/5">
                <div class="mr-4 text-center">
                    <img src="<%= assetsURL %>/logo2.png" alt="background" class="w-14 h-14 mx-auto" />
                    <p class="font-sans text-xs m-0 mt-2">G.A.D.OR.</p>
                </div>                
            </div>
    
            <!-- Columna Centro -->
            <div class="w-3/5 text-center">
                <div class="flex flex-col justify-between font-sans">
                    <h4 class="text-sm m-0 mb-2">Gobierno Autónomo del Departamento de Oruro</h4>
                    <h6 class="text-xs m-0 mb-2"><%= info.area_usuario_padre %>  </h6>  
                    <h6 class="text-xs m-0 mb-2"><%= info.area_usuario_hijo %>  </h6>                    
                </div>
                <div class="w-5/5 mr-4 text-center  whitespace-nowrap overflow-hidden text-ellipsis">
                    <h5 class="text-sm font-semibold mt-auto">REPORTE DE CITES</h5>
                   <!-- <h4 class="text-xs m-0 mb-auto">Correspondiente a las fechas de <%= data.fecha_inicio_filtro %>  </h4>-->
                           
                </div>   
            </div>
    
            <!-- Columna Derecha -->
            <div class="w-1/5 text-right">
                <!-- <img src="<%= qrCodeDataUrl %>" alt="QR Code" class="w-24 h-24 m-0 p-0 float-right">-->
            </div>
        </div>
                 
    </header>

    <!-- Main Content -->
    <main class="w-full mx-auto mt-8">
        <!-- Table -->
       
        <!--Cuerpo nuevo de la tabla-->
        <div>
            
            <div class="flex justify-center">
                <table class="text-xxs text-left border-collapse border border-gray-300" style="width: 100%;">
                   
                        <thead>
                            <tr class="bg-gray-200">
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Fecha de Registro</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 150px;font-size: 8px">Cite Completo</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Tipo de Documento</th>                          
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 200px;font-size: 8px">Area Solicitante</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 200px;font-size: 8px">Area Destino </th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Hoja de Ruta</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Gestion</th>
                                <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Estado</th>
                               
                            </tr>
                        </thead>
                      <tbody>
                        <% if (data) { %>
                                <% data.rows.forEach(function(row){ %>
                                    <tr>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.fecha_registro %></td>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 150px;font-size: 8px"><%= row.cite_completo %></td>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.tipo_documento %></td>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 200px;font-size: 8px"><%= row.nombre_area_solicitante %></td>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 200px;font-size: 8px"><%= row.nombre_area_destino %></td>
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.hoja_ruta %></td>   
                                        <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.gestion %></td>  
                                        <% if (row.estado=="ACTIVO" ) { %>                                       
                                            <td class="text-xs text-green-700 border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px">
                                                <span class="p-1 border border-green-500 rounded text-center text-green-500 text-smallest w-17"> <%= row.estado %></span>                                                  
                                            </td>                            
                                        <% } %> 
                                        <% if (row.estado=="ANULADO" ) { %>                                       
                                            <td class="text-xs text-red-700 border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px">
                                                <span class="p-1 border border-red-500 rounded text-center text-red-500 text-smallest w-17"> <%= row.estado %></span>       
                                            </td>                            
                                        <% } %>   
                                      
                                         
                                    </tr>                               
                                <% }); %>                                            
    
                            <% } %>
                        </tbody>
            
                   <!--  <thead>
                        <tr class="bg-gray-200">
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Num. Recibo</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 120px;font-size: 8px">Apertura Prog.</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">FF_OF</th>                          
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">C.I.</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 200px;font-size: 8px">Nombre Completo</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Sigla</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 120px;font-size: 8px">Cod. Memorandum</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 150px;font-size: 8px">Destino</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Fecha inicio</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 100px;font-size: 8px">Fecha fin</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Total Pasajes</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Total Viatico</th>
                            <th class="text-xxs border border-gray-300 text-center"  style="width: 80px;font-size: 8px">Liquido Pagable</th>
                        </tr>
                    </thead>
                  <tbody>
                    <% if (data) { %>
                            <% data.rows.forEach(function(row){ %>
                                <tr>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.nume_recibo %></td>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 120px;font-size: 8px"><%= row.apertura_programatica %></td>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.ff_of %></td>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.usuario_ci %></td>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 200px;font-size: 8px"><%= row.usuario_nombre %></td>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.sigla %></td>   
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 120px;font-size: 8px"><%= row.cod_depart_memo %></td>      
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 150px;font-size: 8px"><%= row.destino %></td>  
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.fecha_inicio_viaje %></td> 
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 100px;font-size: 8px"><%= row.fecha_fin_viaje %></td>
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.total_pasajes %></td> 
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.total_viatico %></td>  
                                    <td class="text-xs border border-gray-300 text-center w-full" style="width: 80px;font-size: 8px"><%= row.liquido_pagable %></td>  
                                </tr>                               
                            <% }); %>                                            

                        <% } %>
                    </tbody>--> 
                </table>
            </div>
        </div>



        <!---Fin Cuerpo de la tabla -->
      
      
    </main>
</body>

</html>